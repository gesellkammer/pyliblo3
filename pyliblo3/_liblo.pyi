from typing import Any, Callable

__all__: list[str]

UDP: int
TCP: int
UNIX: int
LO_UDP: int
LO_TCP: int
LO_UNIX: int
LO_DEFAULT: int


def time() -> float: ...


def send(target: Address | tuple[str, int] | int | str, *args: Any) -> None: ...


class Callback:
    def __init__(self, func: Callable, user_data: Any) -> None: ...


class struct:
    def __init__(self, **kwargs: Any) -> None: ...


class ServerError(Exception):
    num: int
    msg: str
    where: str | None
    def __init__(self, num: int, msg: str, where: str | None) -> None: ...


# decorator to register callbacks

class make_method:
    def __init__(self, path: str | None, types: str | None, user_data: Any = None) -> None: ...
    def __call__(self, f: Callable[..., Any]) -> Callable[..., Any]: ...


# common base class for both Server and ServerThread

class _ServerBase:
    def __init__(self, reg_methods: bool = True) -> None: ...
    def register_methods(self, obj: Any = None) -> None: ...
    def get_url(self) -> str: ...
    def get_port(self) -> int: ...
    def get_protocol(self) -> int: ...
    def fileno(self) -> int: ...
    def add_method(self, path: str | None, typespec: str | None, func: Callable[..., Any], user_data: Any = None) -> None: ...
    def del_method(self, path: str | None, typespec: str | None = None) -> None: ...
    def add_bundle_handlers(self, start_handler: Callable[..., Any], end_handler: Callable[..., Any], user_data: Any = None) -> None: ...
    def send(self, target: Address | tuple[str, int] | int | str, *args: Any) -> None: ...

    @property
    def url(self) -> str: ...

    @property
    def port(self) -> int: ...

    @property
    def protocol(self) -> int: ...


class Server(_ServerBase):
    def __init__(self, port: int | str | None = None, proto: int | str = LO_DEFAULT, reg_methods: bool = True) -> None: ...
    def free(self) -> None: ...
    def recv(self, timeout: int | float | None = None) -> bool: ...


class ServerThread(_ServerBase):
    def __init__(self, port: int | str | None = None, proto: int | str = LO_DEFAULT, reg_methods: bool = True) -> None: ...
    def free(self) -> None: ...
    def start(self) -> None: ...
    def stop(self) -> None: ...


class AddressError(Exception):
    msg: str
    def __init__(self, msg: str) -> None: ...


class Address:
    """
    An Address represents a destination for a message

    Possible forms:

    * `Address(hostname: str, port: int, proto: [int | str] = LO_UDP)`
    * `Address(port: int)`   # Assumes localhost
    * `Address(url: str)`    # A URL of the form 'osc.udp://hostname:1234/'
    """

    def __init__(self, addr: str | int, addr2: int | None = None, proto: int | str = LO_UDP) -> None: ...
    def get_url(self) -> str: ...
    def get_hostname(self) -> str: ...
    def get_port(self) -> int | str: ...
    def get_protocol(self) -> int: ...

    @property
    def url(self) -> str: ...

    @property
    def hostname(self) -> str: ...

    @property
    def port(self) -> int | str: ...

    @property
    def protocol(self) -> int: ...


class Message:
    def __init__(self, path: str, *args: Any) -> None: ...
    def add(self, *args: Any) -> None: ...


class Bundle:
    def __init__(self, *messages: Any) -> None: ...
    def add(self, *args: Any) -> None: ...
